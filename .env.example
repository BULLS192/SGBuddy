# Required for live LTA DataMall data.
LTA_ACCOUNT_KEY=

# Optional. Public data.gov.sg currently works without a key at normal limits.
DATA_GOV_SG_API_KEY=

# Optional: enables native Singapore street/place search in Wave 4.
# OneMap tokens expire; email/password lets SGBuddy refresh automatically.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
# Alternatively provide a short-lived token (not recommended for long-running production use).
ONEMAP_TOKEN=

# v0.8 AIXIA Supabase catalog (publishable key only; server-only tables remain behind RLS)
SGBUDDY_SUPABASE_URL=
SGBUDDY_SUPABASE_PUBLISHABLE_KEY=


# Local ingestion only. NEVER expose this in client code or commit a real value.
# Required only when intentionally running the staged catalog/FX ingestion scripts.
SGBUDDY_SUPABASE_SERVICE_ROLE_KEY=
